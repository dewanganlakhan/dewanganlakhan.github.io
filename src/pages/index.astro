---
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import FeatherIcon from '../components/FeatherIcon.astro';
---

<Layout>
  <!-- Header with Theme Toggle -->
  <header class="dark:bg-primary-dark bg-primary-light text-white p-6 rounded-b-xl shadow-lg">
    <div class="container mx-auto max-w-5xl flex flex-col md:flex-row items-center justify-between">
      <div class="flex items-center gap-4">
        <div>
          <h1 class="text-3xl font-bold">Lakhan Dewangan</h1>
          <p class="text-lg">GenAI Developer · RAG Specialist</p>
        </div>
        <ThemeToggle />
      </div>
      <img src="/assets/lakhan1.jpg" alt="Lakhan Dewangan" class="w-32 h-32 rounded-full mt-4 md:mt-0 border-4 border-white shadow-lg object-cover" fetchpriority="high" width="128" height="128" />
    </div>
  </header>

  <!-- Contact Info -->
  <section class="p-6">
    <div class="container mx-auto max-w-5xl grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="dark:bg-surface-dark bg-surface-light dark:text-text-dark text-text-light p-4 rounded-lg shadow flex items-center gap-2">
        <FeatherIcon name="mail" class="text-accent-dark dark:text-accent-light" /><strong>Email:</strong> dewanganlakhan@gmail.com
      </div>
      <div class="dark:bg-surface-dark bg-surface-light dark:text-text-dark text-text-light p-4 rounded-lg shadow flex items-center gap-2">
        <FeatherIcon name="twitter" class="text-accent-dark dark:text-accent-light" /><strong>Twitter:</strong> <a href="https://x.com/dewanganlakhan" class="hover:underline">@dewanganlakhan</a>
      </div>
      <div class="dark:bg-surface-dark bg-surface-light dark:text-text-dark text-text-light p-4 rounded-lg shadow flex items-center gap-2">
        <FeatherIcon name="github" class="text-accent-dark dark:text-accent-light" /><strong>GitHub:</strong> <a href="https://github.com/dewanganlakhan" class="hover:underline">dewanganlakhan</a>
      </div>
      <div class="dark:bg-surface-dark bg-surface-light dark:text-text-dark text-text-light p-4 rounded-lg shadow flex items-center gap-2">
        <FeatherIcon name="hash" class="text-accent-dark dark:text-accent-light" /><strong>Hashnode:</strong> <a href="https://hashnode.com/@lakhan01" class="hover:underline">@lakhan01</a>
      </div>
      <div class="dark:bg-surface-dark bg-surface-light dark:text-text-dark text-text-light p-4 rounded-lg shadow flex items-center gap-2">
        <FeatherIcon name="gift" class="text-accent-dark dark:text-accent-light" /><strong>Birthday:</strong> 07 June
      </div>
      <div class="dark:bg-surface-dark bg-surface-light dark:text-text-dark text-text-light p-4 rounded-lg shadow flex items-center gap-2">
        <FeatherIcon name="map-pin" class="text-accent-dark dark:text-accent-light" /><strong>Location:</strong> Bilaspur, C.G., India
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section class="p-6 dark:bg-surface-dark bg-gray-100 rounded-xl shadow mx-4">
    <div class="container mx-auto max-w-5xl">
      <h2 class="text-2xl font-semibold dark:text-text-dark text-text-light mb-4">About Me</h2>
      <p class="mb-4">I'm a software engineer running a small company called <strong>Criptocode IT Solutions</strong> in Bilaspur, Chhattisgarh, India.</p>
      <p class="mb-4">Learning and implementing Generative AI and Retrieval-Augmented Generation (RAG) applications to solve real-world problems.</p>
      <p class="mb-4">India was the leader in Call Centers followed by IT services. Now it's going to be a Software Hub.</p>
      <p class="mb-4">My mission is to mentor 100 students in web development for free.</p>
    </div>
  </section>

  <!-- Featured Software Tools & Products -->
  <section class="p-6 mt-6 dark:bg-background-dark bg-background-light rounded-xl shadow mx-4">
    <div class="container mx-auto max-w-5xl">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-2xl font-bold dark:text-text-dark text-text-light">Featured Tools & Extensions</h2>
          <p class="text-sm text-gray-500 dark:text-gray-400">Handcrafted SEO, AI, and developer tools built by Lakhan Dewangan</p>
        </div>
      </div>

      <!-- Tool Card: Instant KW -->
      <div class="dark:bg-surface-dark bg-surface-light border border-gray-200 dark:border-gray-800 rounded-xl p-6 shadow-lg hover:shadow-xl transition-all">
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
          <div class="flex items-start gap-4">
            <img 
              src="/assets/instant-kw/icon128.png" 
              alt="Instant KW Icon" 
              class="w-16 h-16 rounded-xl shadow p-1.5 bg-indigo-500/10 border border-indigo-500/20 object-contain flex-shrink-0"
              width="64"
              height="64"
            />
            <div>
              <div class="flex flex-wrap items-center gap-2 mb-1">
                <h3 class="text-xl font-bold text-gray-900 dark:text-white">Instant KW</h3>
                <span class="bg-indigo-100 dark:bg-indigo-950 text-indigo-700 dark:text-indigo-300 text-xs font-semibold px-2.5 py-0.5 rounded-full border border-indigo-200 dark:border-indigo-800">
                  Chrome Extension
                </span>
                <span class="bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300 text-xs font-semibold px-2.5 py-0.5 rounded-full flex items-center gap-1">
                  <FeatherIcon name="check-circle" class="w-3 h-3 text-emerald-600 dark:text-emerald-400" />
                  Live on Chrome Web Store
                </span>
              </div>
              <p class="text-gray-600 dark:text-gray-300 text-sm leading-relaxed mb-3">
                Google Autocomplete & Wildcard Harvester. Harvest long-tail keyword suggestions across Level 1 & Deep Level 2 inner wildcards with 1-click CSV exports.
              </p>
              <div class="flex flex-wrap gap-2">
                <span class="text-xs bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 px-2 py-0.5 rounded">Google Autocomplete</span>
                <span class="text-xs bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 px-2 py-0.5 rounded">L1 & L2 Wildcards</span>
                <span class="text-xs bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 px-2 py-0.5 rounded">Keyword Studio</span>
                <span class="text-xs bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 px-2 py-0.5 rounded">CSV Export</span>
              </div>
            </div>
          </div>
          
          <div class="flex flex-col sm:flex-row items-stretch md:items-center gap-3 w-full md:w-auto flex-shrink-0">
            <a 
              href="https://chromewebstore.google.com/detail/instant-kw-google-autocom/hbpogodbnfedlaofnjonjnbckjofkfgg" 
              target="_blank" 
              rel="noopener noreferrer"
              class="bg-indigo-600 hover:bg-indigo-700 text-white font-medium px-4 py-2.5 rounded-lg shadow text-sm text-center flex items-center justify-center gap-2 transition-colors"
            >
              <FeatherIcon name="external-link" class="w-4 h-4" />
              <span>Add to Chrome</span>
            </a>
            <a 
              href="/instant-kw" 
              class="dark:bg-gray-800 bg-gray-100 hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-900 dark:text-white font-medium px-4 py-2.5 rounded-lg shadow text-sm text-center flex items-center justify-center gap-2 border border-gray-300 dark:border-gray-700 transition-colors"
            >
              <span>Explore Tool Page</span>
              <FeatherIcon name="arrow-right" class="w-4 h-4" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How I Help -->
  <section class="p-6 mt-6 dark:bg-secondary-dark bg-primary-light bg-opacity-90 dark:text-text-dark text-white rounded-xl shadow mx-4">
    <div class="container mx-auto max-w-5xl">
      <h2 class="text-2xl font-semibold mb-4">Here's how I can help you:</h2>
      <ul class="list-disc list-inside space-y-2">
        <li>I'll share links to useful YouTube courses and tutorials.</li>
        <li>I'll give you tips, tricks, and hacks for quick learning and problem-solving.</li>
        <li>You'll work on real projects for hands-on experience, helping you gain confidence.</li>
        <li>To join, follow me on Instagram.</li>
      </ul>
    </div>
  </section>

  <!-- Mission & Vision -->
  <section class="p-6 dark:bg-surface-dark bg-gray-100 mt-6 rounded-xl shadow mx-4">
    <div class="container mx-auto max-w-5xl grid md:grid-cols-2 gap-6">
      <div class="dark:bg-secondary-dark bg-accent-light p-4 rounded-lg shadow text-white">
        <h3 class="text-xl font-semibold mb-2">Mission</h3>
        <p>On a mission to successfully transform the careers of 100 students through mentorship.</p>
      </div>
      <div class="dark:bg-secondary-dark bg-accent-light p-4 rounded-lg shadow text-white">
        <h3 class="text-xl font-semibold mb-2">Vision</h3>
        <p>Every college student must know how to create a simple website.</p>
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section class="p-6 dark:bg-background-dark bg-background-light mt-6 rounded-xl shadow mx-4">
    <div class="container mx-auto max-w-5xl">
      <h2 class="text-2xl font-semibold dark:text-text-dark text-text-light mb-4">AI & Modern Tech Skills</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="dark:bg-surface-dark bg-surface-light p-4 rounded-lg shadow text-center hover:transform hover:scale-105 transition-transform">
          <FeatherIcon name="cpu" class="mx-auto mb-2 text-accent-dark dark:text-accent-light" />
          <h3 class="font-semibold dark:text-text-dark text-text-light">GenAI</h3>
        </div>
        <div class="dark:bg-surface-dark bg-surface-light p-4 rounded-lg shadow text-center hover:transform hover:scale-105 transition-transform">
          <FeatherIcon name="book-open" class="mx-auto mb-2 text-accent-dark dark:text-accent-light" />
          <h3 class="font-semibold dark:text-text-dark text-text-light">RAG</h3>
        </div>
        <div class="dark:bg-surface-dark bg-surface-light p-4 rounded-lg shadow text-center hover:transform hover:scale-105 transition-transform">
          <FeatherIcon name="database" class="mx-auto mb-2 text-accent-dark dark:text-accent-light" />
          <h3 class="font-semibold dark:text-text-dark text-text-light">QdrantDB</h3>
        </div>
        <div class="dark:bg-surface-dark bg-surface-light p-4 rounded-lg shadow text-center hover:transform hover:scale-105 transition-transform">
          <FeatherIcon name="trending-up" class="mx-auto mb-2 text-accent-dark dark:text-accent-light" />
          <h3 class="font-semibold dark:text-text-dark text-text-light">LangChain</h3>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="dark:bg-primary-dark bg-primary-light text-white p-4 text-center mt-8 rounded-t-xl">
    <div class="container mx-auto max-w-5xl">
      &copy; 2026 Lakhan Dewangan · Criptocode IT Solutions
    </div>
  </footer>
</Layout>
