---
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
---

<Layout>
  <!-- Header with Theme Toggle -->
  <header class="dark:bg-primary-dark bg-primary-light text-white p-6 rounded-b-xl shadow-lg">
    <div class="container mx-auto max-w-5xl flex flex-col md:flex-row items-center justify-between">
      <div class="flex items-center gap-4">
        <div>
          <h1 class="text-3xl font-bold">Lakhan Dewangan</h1>
          <p class="text-lg">GenAI Developer · RAG Specialist</p>
        </div>
        <ThemeToggle />
      </div>
      <img src="/assets/lakhan1.jpg" alt="Lakhan Dewangan" class="w-32 h-32 rounded-full mt-4 md:mt-0 border-4 border-white shadow-lg object-cover" />
    </div>
  </header>

  <!-- Contact Info -->
  <section class="p-6">
    <div class="container mx-auto max-w-5xl grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="dark:bg-surface-dark bg-surface-light dark:text-text-dark text-text-light p-4 rounded-lg shadow flex items-center gap-2">
        <i data-feather="mail" class="text-accent-dark dark:text-accent-light"></i><strong>Email:</strong> dewanganlakhan@gmail.com
      </div>
      <div class="dark:bg-surface-dark bg-surface-light dark:text-text-dark text-text-light p-4 rounded-lg shadow flex items-center gap-2">
        <i data-feather="twitter" class="text-accent-dark dark:text-accent-light"></i><strong>Twitter:</strong> <a href="https://x.com/dewanganlakhan" class="hover:underline">@dewanganlakhan</a>
      </div>
      <div class="dark:bg-surface-dark bg-surface-light dark:text-text-dark text-text-light p-4 rounded-lg shadow flex items-center gap-2">
        <i data-feather="github" class="text-accent-dark dark:text-accent-light"></i><strong>GitHub:</strong> <a href="https://github.com/dewanganlakhan" class="hover:underline">dewanganlakhan</a>
      </div>
      <div class="dark:bg-surface-dark bg-surface-light dark:text-text-dark text-text-light p-4 rounded-lg shadow flex items-center gap-2">
        <i data-feather="hash" class="text-accent-dark dark:text-accent-light"></i><strong>Hashnode:</strong> <a href="https://hashnode.com/@lakhan01" class="hover:underline">@lakhan01</a>
      </div>
      <div class="dark:bg-surface-dark bg-surface-light dark:text-text-dark text-text-light p-4 rounded-lg shadow flex items-center gap-2">
        <i data-feather="gift" class="text-accent-dark dark:text-accent-light"></i><strong>Birthday:</strong> 07 June
      </div>
      <div class="dark:bg-surface-dark bg-surface-light dark:text-text-dark text-text-light p-4 rounded-lg shadow flex items-center gap-2">
        <i data-feather="map-pin" class="text-accent-dark dark:text-accent-light"></i><strong>Location:</strong> Bilaspur, C.G., India
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section class="p-6 dark:bg-surface-dark bg-gray-100 rounded-xl shadow mx-4">
    <div class="container mx-auto max-w-5xl">
      <h2 class="text-2xl font-semibold dark:text-text-dark text-text-light mb-4">About Me</h2>
      <p class="mb-4">I'm a software engineer running a small company called <strong>Criptocode IT Solutions</strong> in Bilaspur, Chhattisgarh, India.</p>
      <p class="mb-4">Learning and implementing Generative AI and Retrieval-Augmented Generation (RAG) applications to solve real-world problems.</p>
      <p class="mb-4">India was the leader in Call Centers followed by IT services. Now it's going to be a Software Hub.</p>
      <p class="mb-4">My mission is to mentor 100 students in web development for free.</p>
    </div>
  </section>

  <!-- How I Help -->
  <section class="p-6 mt-6 dark:bg-secondary-dark bg-primary-light bg-opacity-90 dark:text-text-dark text-white rounded-xl shadow mx-4">
    <div class="container mx-auto max-w-5xl">
      <h2 class="text-2xl font-semibold mb-4">Here's how I can help you:</h2>
      <ul class="list-disc list-inside space-y-2">
        <li>I'll share links to useful YouTube courses and tutorials.</li>
        <li>I'll give you tips, tricks, and hacks for quick learning and problem-solving.</li>
        <li>You'll work on real projects for hands-on experience, helping you gain confidence.</li>
        <li>To join, follow me on Instagram.</li>
      </ul>
    </div>
  </section>

  <!-- Mission & Vision -->
  <section class="p-6 dark:bg-surface-dark bg-gray-100 mt-6 rounded-xl shadow mx-4">
    <div class="container mx-auto max-w-5xl grid md:grid-cols-2 gap-6">
      <div class="dark:bg-secondary-dark bg-accent-light p-4 rounded-lg shadow text-white">
        <h3 class="text-xl font-semibold mb-2">Mission</h3>
        <p>On a mission to successfully transform the careers of 100 students through mentorship.</p>
      </div>
      <div class="dark:bg-secondary-dark bg-accent-light p-4 rounded-lg shadow text-white">
        <h3 class="text-xl font-semibold mb-2">Vision</h3>
        <p>Every college student must know how to create a simple website.</p>
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section class="p-6 dark:bg-background-dark bg-background-light mt-6 rounded-xl shadow mx-4">
    <div class="container mx-auto max-w-5xl">
      <h2 class="text-2xl font-semibold dark:text-text-dark text-text-light mb-4">AI & Modern Tech Skills</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="dark:bg-surface-dark bg-surface-light p-4 rounded-lg shadow text-center hover:transform hover:scale-105 transition-transform">
          <i data-feather="cpu" class="mx-auto mb-2 text-accent-dark dark:text-accent-light"></i>
          <h3 class="font-semibold dark:text-text-dark text-text-light">GenAI</h3>
        </div>
        <div class="dark:bg-surface-dark bg-surface-light p-4 rounded-lg shadow text-center hover:transform hover:scale-105 transition-transform">
          <i data-feather="book-open" class="mx-auto mb-2 text-accent-dark dark:text-accent-light"></i>
          <h3 class="font-semibold dark:text-text-dark text-text-light">RAG</h3>
        </div>
        <div class="dark:bg-surface-dark bg-surface-light p-4 rounded-lg shadow text-center hover:transform hover:scale-105 transition-transform">
          <i data-feather="database" class="mx-auto mb-2 text-accent-dark dark:text-accent-light"></i>
          <h3 class="font-semibold dark:text-text-dark text-text-light">QdrantDB</h3>
        </div>
        <div class="dark:bg-surface-dark bg-surface-light p-4 rounded-lg shadow text-center hover:transform hover:scale-105 transition-transform">
          <i data-feather="trending-up" class="mx-auto mb-2 text-accent-dark dark:text-accent-light"></i>
          <h3 class="font-semibold dark:text-text-dark text-text-light">LangChain</h3>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="dark:bg-primary-dark bg-primary-light text-white p-4 text-center mt-8 rounded-t-xl">
    <div class="container mx-auto max-w-5xl">
      &copy; 2026 Lakhan Dewangan · Criptocode IT Solutions
    </div>
  </footer>
</Layout>
