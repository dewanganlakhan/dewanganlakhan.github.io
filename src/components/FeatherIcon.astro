const iconHtml = FEATHER_ICONS[name];
---
{iconHtml ? (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class={`feather feather-${name} ${className || ''}`}
    set:html={iconHtml}
    {...rest}
  />
) : null}
